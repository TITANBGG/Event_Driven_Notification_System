# Optional environment overrides; docker compose runs without a .env file via defaults.
# Every credential below (PostgreSQL, Redis, API keys) is a LOCAL-DEVELOPMENT default: replace all of
# them before exposing the stack anywhere. PostgreSQL and Redis are published on 127.0.0.1 only.

# Network & Storage
HTTP_ADDR=:8080
WORKER_METRICS_ADDR=:9091
POSTGRES_USER=notif
POSTGRES_PASSWORD=notif
POSTGRES_DB=notif
POSTGRES_PORT=5432
DATABASE_URL=postgres://notif:notif@postgres:5432/notif?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PORT=6379
# Redis AUTH password (requirepass). Empty in code = no AUTH; docker-compose.yml sets this local-dev value.
REDIS_PASSWORD=local-dev-redis-change-me
REDIS_POOL_SIZE=0
# PostgreSQL pool size per process; 0 = auto (api 20, worker 10). Keep replicas*pool + api <= max_connections (100).
DB_MAX_CONNS=0

# External Provider (EXT-1)
PROVIDER_URL=http://mockprovider:8090/
# PROVIDER_URL=https://webhook.site/<your-uuid>
PROVIDER_TIMEOUT=10s
PROVIDER_EXTENDED_FIELDS=false

# Rate Limit & Worker Pool
RATE_LIMIT_PER_SEC=100
RATE_LIMIT_BURST=1
WORKER_ID=worker-local
WORKER_CONCURRENCY_PER_CHANNEL=25

# Retry & Backoff
MAX_ATTEMPTS=5
RETRY_BASE=2s
RETRY_CAP=5m
RETRY_MIN=200ms
RETRY_AFTER_MAX=15m

# Circuit Breaker
CB_CONSECUTIVE_FAILURES=10
CB_MIN_REQUESTS=20
CB_FAILURE_RATIO=0.5
CB_INTERVAL=60s
CB_OPEN_TIMEOUT=30s
CB_HALF_OPEN_MAX=3
MAX_CIRCUIT_DEFERRALS=120

# Reconciler, Leases & Lifecycle
VISIBILITY_TIMEOUT=60s
RECONCILE_INTERVAL=15s
PENDING_STALE_AFTER=30s
DELAYED_MOVER_INTERVAL=500ms
HEARTBEAT_INTERVAL=5s
HEARTBEAT_TTL=15s
CLOCK_SKEW_TOLERANCE=2s
SHUTDOWN_TIMEOUT=15s

# API Limits, Idempotency & CORS
MAX_BODY_BYTES=524288
BATCH_MAX_BODY_BYTES=16777216
BATCH_MAX_ITEMS=1000
PAGE_LIMIT_DEFAULT=50
PAGE_LIMIT_MAX=200
IDEMPOTENCY_TTL=24h
SCHEDULE_MAX_AHEAD=720h
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Max concurrent WebSocket clients per API replica (B-4); extra connections get 503 too_many_ws_clients.
MAX_WS_CLIENTS=1000

# API authentication: comma-separated name:secret:scope1|scope2 entries; scopes are read, write, admin
# (admin implies all). Empty disables auth (the API logs a warning). Secrets: 16..256 chars of
# letters, digits and !#$%&'*+-.^_`|~. Clients send Authorization: Bearer <secret>; browsers open the
# WebSocket with subprotocols ["bearer", "<secret>"]. docker-compose.yml enables these local-dev keys
# (admin + read-only) by default: replace them outside local development.
API_KEYS=local-dev:local-dev-key-change-me:admin,local-dev-read:local-dev-read-key-change-me:read
# API_KEYS=ops:<secret>:admin,shop-frontend:<secret>:write,dashboard:<secret>:read
# Per-API-key request limit across all API replicas (GCRA in Redis, burst = rate); 0 disables it.
# Over the limit: 429 rate_limited + Retry-After. Fails open when Redis is down (the API is DB-first).
API_RATE_LIMIT_PER_SEC=0
# Ingress backpressure: creates get 503 overloaded + Retry-After while the sampled ready-queue backlog
# (all channels and priorities) is at or above this many items; 0 disables it.
INGRESS_MAX_QUEUE_DEPTH=1000000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SAMPLER_RATIO=1.0
LOG_LEVEL=info

# Mock Provider Tuning
MOCK_PORT=8090
MOCK_LATENCY_MS=0
MOCK_LATENCY_JITTER_MS=0
MOCK_FAILURE_RATE=0
MOCK_429_RATE=0
MOCK_PERMANENT_RATE=0
MOCK_SEED=0
