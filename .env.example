# Optional environment overrides; docker compose runs without a .env file via defaults.

# Network & Storage
HTTP_ADDR=:8080
WORKER_METRICS_ADDR=:9091
POSTGRES_USER=notif
POSTGRES_PASSWORD=notif
POSTGRES_DB=notif
POSTGRES_PORT=5432
DATABASE_URL=postgres://notif:notif@postgres:5432/notif?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PORT=6379
REDIS_POOL_SIZE=0
# PostgreSQL pool size per process; 0 = auto (api 20, worker 10). Keep replicas*pool + api <= max_connections (100).
DB_MAX_CONNS=0

# External Provider (EXT-1)
PROVIDER_URL=http://mockprovider:8090/
# PROVIDER_URL=https://webhook.site/<your-uuid>
PROVIDER_TIMEOUT=10s
PROVIDER_EXTENDED_FIELDS=false

# Rate Limit & Worker Pool
RATE_LIMIT_PER_SEC=100
RATE_LIMIT_BURST=1
WORKER_ID=worker-local
WORKER_CONCURRENCY_PER_CHANNEL=25

# Retry & Backoff
MAX_ATTEMPTS=5
RETRY_BASE=2s
RETRY_CAP=5m
RETRY_MIN=200ms
RETRY_AFTER_MAX=15m

# Circuit Breaker
CB_CONSECUTIVE_FAILURES=10
CB_MIN_REQUESTS=20
CB_FAILURE_RATIO=0.5
CB_INTERVAL=60s
CB_OPEN_TIMEOUT=30s
CB_HALF_OPEN_MAX=3
MAX_CIRCUIT_DEFERRALS=120

# Reconciler, Leases & Lifecycle
VISIBILITY_TIMEOUT=60s
RECONCILE_INTERVAL=15s
PENDING_STALE_AFTER=30s
DELAYED_MOVER_INTERVAL=500ms
HEARTBEAT_INTERVAL=5s
HEARTBEAT_TTL=15s
CLOCK_SKEW_TOLERANCE=2s
SHUTDOWN_TIMEOUT=15s

# API Limits, Idempotency & CORS
MAX_BODY_BYTES=524288
BATCH_MAX_BODY_BYTES=16777216
BATCH_MAX_ITEMS=1000
PAGE_LIMIT_DEFAULT=50
PAGE_LIMIT_MAX=200
IDEMPOTENCY_TTL=24h
SCHEDULE_MAX_AHEAD=720h
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Max concurrent WebSocket clients per API replica (B-4); extra connections get 503 too_many_ws_clients.
MAX_WS_CLIENTS=1000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SAMPLER_RATIO=1.0
LOG_LEVEL=info

# Mock Provider Tuning
MOCK_PORT=8090
MOCK_LATENCY_MS=0
MOCK_LATENCY_JITTER_MS=0
MOCK_FAILURE_RATE=0
MOCK_429_RATE=0
MOCK_PERMANENT_RATE=0
MOCK_SEED=0
